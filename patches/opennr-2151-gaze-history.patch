+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+
+namespace NeuralRendering
+{
+	struct SecondPassCropRect
+	{
+		std::uint32_t x = 0;
+		std::uint32_t y = 0;
+		std::uint32_t width = 0;
+		std::uint32_t height = 0;
+	};
+
+	struct SecondPassCropPlan
+	{
+		SecondPassCropRect color;
