+float ResolveMotionConfidence(uint2 localPixel)
+{
+	if (UseMotionConfidence == 0u || MotionWidth == 0u || MotionHeight == 0u)
+		return 1.0;
+	const float2 uv = (float2(localPixel) + 0.5) / float2(max(SubWidth, 1u), max(SubHeight, 1u));
+	const uint2 guidePixel = uint2(MotionOffsetX, MotionOffsetY) +
+		min(uint2(uv * float2(MotionWidth, MotionHeight)),
+			uint2(MotionWidth - 1u, MotionHeight - 1u));
+	const float2 motion = MotionTex.Load(int3(guidePixel, 0));
+	if (!all(motion == motion) || any(abs(motion) > 10000.0))
+		return 0.0;
+	const float motionPixels = length(motion * float2(MotionScaleX, MotionScaleY));
+	return 1.0 - smoothstep(1.0, max(MotionThresholdPixels, 1.0), motionPixels);
+}
