+	if (DetailBoost > 1.0 || SourceContribution < 1.0 || OriginalColour > 0.0 ||
+		OriginalBrightness > 0.0 || UseMotionConfidence != 0u) {
+		float3 original = DstTex[dstPos].rgb;
+		if (DetailBoost > 1.0) {
+			const float3 lumaWeights = float3(0.2126, 0.7152, 0.0722);
+			const float originalY = dot(original, lumaWeights);
+			const float neuralY = dot(dlss.rgb, lumaWeights);
+			const float localRatio = clamp(neuralY / max(originalY, 0.04), 0.5, 1.5);
+			float3 detail = dlss.rgb - original;
+			detail *= lerp(1.0, localRatio, saturate(DetailBoost - 1.0));
+			dlss.rgb = max(original + detail, 0.0.xxx);
+		}
+	if (OriginalColour > 0.0 || OriginalBrightness > 0.0) {
+		const float3 lumaWeights = float3(0.2126, 0.7152, 0.0722);
+		float originalY = dot(original, lumaWeights);
+		float neuralY = dot(dlss.rgb, lumaWeights);
+		float3 chroma = lerp(dlss.rgb - neuralY, original - originalY, saturate(OriginalColour));
+		// Keep the requested hue/luma match without clipping HDR/linear scene values
+		// above 1.0. UNORM targets clamp on write; floating-point targets should not.
+		dlss.rgb = max(chroma + lerp(neuralY, originalY, saturate(OriginalBrightness)), 0.0.xxx);
+	}
+		dlss.rgb = lerp(original, dlss.rgb,
+			saturate(SourceContribution) * ResolveMotionConfidence(tid.xy));
+	}
+	if (BlendMode == 2) {
+		DstTex[dstPos] = dlss;
+		return;
+	}
